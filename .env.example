APP_NAME="Smart Weighbridge Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_weighbridge
DB_USERNAME=root
DB_PASSWORD=

# Cloud database mirror (DigitalOcean Managed MySQL)
CLOUD_SYNC_ENABLED=false
DB_CLOUD_HOST=
DB_CLOUD_PORT=25060
DB_CLOUD_DATABASE=smart_weighbridge
DB_CLOUD_USERNAME=
DB_CLOUD_PASSWORD=
# Download CA cert from DO: Database → your cluster → Connection details → Download CA certificate
# Save as storage/certs/ca-certificate.crt then set full path below (Windows example):
DB_CLOUD_SSL_CA=C:\smart-weighbridge-management-system\storage\certs\ca-certificate.crt

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@weighbridge.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# NativePHP desktop (Windows native app window — no browser address bar)
NATIVEPHP_APP_ID=com.smartweighbridge.app
NATIVEPHP_APP_VERSION=1.1.1
NATIVEPHP_APP_DESCRIPTION="Smart Weighbridge Management System"
NATIVEPHP_UPDATER_ENABLED=false

# Weighbridge hardware
# dummy  = simulation (recommended for first setup)
# xk3190 = live XK3190-DS17 via COM port (PHP must run on that Windows PC)
WEIGHBRIDGE_DRIVER=dummy
WEIGHBRIDGE_COM_PORT=COM3
WEIGHBRIDGE_BAUD_RATE=9600
WEIGHBRIDGE_DATA_BITS=8
WEIGHBRIDGE_STOP_BITS=1
WEIGHBRIDGE_PARITY=none
WEIGHBRIDGE_FLOW_CONTROL=none
# Set to 3 only if the LED shows 20.000 kg and Live Scale shows 20000
WEIGHBRIDGE_DECIMAL_PLACES=0
