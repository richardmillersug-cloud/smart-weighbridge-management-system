APP_NAME="Smart Weighbridge Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Local primary database (station PC)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_weighbridge
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# Cloud database mirror (DigitalOcean Managed MySQL)
CLOUD_SYNC_ENABLED=true
DB_CLOUD_HOST=
DB_CLOUD_PORT=25060
DB_CLOUD_DATABASE=smart_weighbridge
DB_CLOUD_USERNAME=
DB_CLOUD_PASSWORD=
DB_CLOUD_SSL_CA=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@weighbridge.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

NATIVEPHP_APP_ID=com.smartweighbridge.app
NATIVEPHP_APP_VERSION=1.1.1
NATIVEPHP_UPDATER_ENABLED=false

# Live XK3190-DS17 indicator (must run on the same Windows PC as COM port)
WEIGHBRIDGE_DRIVER=xk3190
WEIGHBRIDGE_COM_PORT=COM1
WEIGHBRIDGE_BAUD_RATE=9600
WEIGHBRIDGE_DATA_BITS=8
WEIGHBRIDGE_STOP_BITS=1
WEIGHBRIDGE_PARITY=none
WEIGHBRIDGE_FLOW_CONTROL=none
WEIGHBRIDGE_DECIMAL_PLACES=0
